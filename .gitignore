# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# uv
# NOTE: uv.lock is NOT yet generated, so it is not committed. The pins in
# pyproject.toml are exact (==), which is the current reproducibility
# guarantee; a lockfile would additionally pin the transitive tree and
# should be added with `uv lock` when uv is available.

# Run outputs. Everything under runs/ is regenerable from a config + seed.
runs/
figures/
*.log

# Data. The small frozen smoke inputs and the prepared target ARE committed
# (see data/smoke/ and data/targets/); bulk downloads and caches are not.
data/raw/
data/processed/
data/cache/
data/chembl/
*.sdf
*.pdbqt.gz

# The docking cache is large, machine-specific and incrementally written.
# It is intentionally not version controlled.
cache/
*.sqlite
*.sqlite-journal

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
